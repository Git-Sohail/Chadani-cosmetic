DATABASE_URL="postgresql://user:password@localhost:5432/cosmetic_store"
JWT_SECRET="change-this-to-a-long-random-secret"

# Gmail SMTP (Nodemailer) — use Google App Password (16 chars), NOT normal Gmail password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Chadani Cosmetic <your-email@gmail.com>"

# If SMTP credentials fail in development, email is printed in the backend console
SMTP_FALLBACK_ON_ERROR=true

# Optional: link in welcome emails
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match Authorized redirect URI in Google Console (backend callback)
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Cloudinary (optional — invalid credentials fall back to local /uploads storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BACKEND_PUBLIC_URL=http://localhost:5000
